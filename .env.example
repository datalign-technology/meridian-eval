# Meridian evaluation stack — configuration.
# Copy this file to `.env` (same folder) before launching:
#     cp .env.example .env
# Everything here has a working default for a local evaluation; the one line
# you SHOULD change is JWT_SECRET.

# ── Which images to pull ──────────────────────────────────────────────────
# Meridian runs on the Procela governance-platform images (the base compose
# file is the unmodified platform bundle, so it reads PROCELA_* here). Pin
# PROCELA_TAG to a released version (e.g. 0.1.35) for a reproducible
# evaluation, or leave `latest` to always pull the newest platform build.
PROCELA_REGISTRY=ghcr.io/datalign-technology
PROCELA_TAG=latest

# ── Security ──────────────────────────────────────────────────────────────
# Signs session tokens (HS256 in the eval build). CHANGE THIS to any long
# random string, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Authentication provider. The evaluation build uses `dev`: sign-in is
# passwordless — enter any name/email on the login screen (or use the
# "Test Accounts" quick-login) and you're in. This is for evaluation only;
# a real deployment sets AUTH_PROVIDER=cognito | azuread | okta | saml.
AUTH_PROVIDER=dev

# ── Demo data ─────────────────────────────────────────────────────────────
# A demo tenant is loaded on first boot so the app isn't empty. Default is the
# shipbuilding fixture (fitting for a naval/maritime evaluation). One of:
# shipbuilding | utilities | healthcare | manufacturing | financial |
# government | logistics | insurance | telecom | education
DEMO_INDUSTRY=shipbuilding

# ── AI features (optional) ────────────────────────────────────────────────
# Off by default so the stack runs with no external calls and no key. To try
# the AI assistant, template generation and suggestions, set ENABLED=true and
# provide a key for your chosen provider.
AI_FEATURES_ENABLED=false
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Storage ───────────────────────────────────────────────────────────────
# Local disk inside the backend container (exports / uploaded files). The
# default is fine for evaluation.
STORAGE_PROVIDER=local

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
